# =============================================
# OLCA Rental — Variables de Entorno
# Copiar a .env y completar valores reales
# =============================================

# --- PostgreSQL ---
POSTGRES_USER=olca
POSTGRES_PASSWORD=olca_secret_change_me
POSTGRES_DB=olca_db

# --- Redis ---
REDIS_PASSWORD=redis_secret_change_me

# --- pgAdmin (opcional, solo tools profile) ---
PGADMIN_EMAIL=admin@olca.com
PGADMIN_PASSWORD=admin123_change_me

# --- JWT ---
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me

# --- Email (Nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@olca.com.ar
SMTP_PASS=your_app_password

# --- Frontend URL (para links en emails) ---
FRONTEND_URL=http://localhost:5173

# --- ERP Odoo (completar cuando haya acceso) ---
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your_odoo_db
ODOO_USERNAME=api_user@olca.com
ODOO_API_KEY=your_odoo_api_key
ERP_MOCK_MODE=true
